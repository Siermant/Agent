[Unit]
Description=GTA independent equity research (no orders)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
WorkingDirectory=/opt/gta-equity-research
StateDirectory=gta-equity-research
StateDirectoryMode=0700
CacheDirectory=gta-equity-export
CacheDirectoryMode=0755
LoadCredential=alpaca-paper.json:/etc/gta-secrets/alpaca-paper.json
ExecStart=/usr/bin/python3 -B -s -m global_agent.equity_job
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=192M
CPUQuota=50%
TimeoutStartSec=10min
